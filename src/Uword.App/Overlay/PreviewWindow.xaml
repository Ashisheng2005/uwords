<Window x:Class="Uword.App.Overlay.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="300" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="White">
    <Border BorderBrush="#AFC2B9" BorderThickness="1" Background="White">
        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SpeakButton" Width="30" Height="28" ToolTip="播放发音"
                            Background="Transparent" BorderThickness="0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="16" />
                    </Button>
                    <Button x:Name="CloseButton" Width="30" Height="28" ToolTip="关闭"
                            Background="Transparent" BorderThickness="0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="13" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="UWORD" FontSize="11" FontWeight="SemiBold" Foreground="#147D61" />
                    <TextBlock x:Name="SourceName" Margin="0,4,8,0" Foreground="#52625D" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,4">
                    <TextBlock Text="原文" FontSize="11" FontWeight="SemiBold" Foreground="#52625D" />
                    <TextBlock x:Name="SelectedText" Margin="0,5,0,0" TextWrapping="Wrap"
                               FontSize="13" Foreground="#172B27" />
                    <Border BorderBrush="#D5DFDB" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
                    <TextBlock Text="译文" FontSize="11" FontWeight="SemiBold" Foreground="#52625D" />
                    <TextBlock x:Name="ResultText" Margin="0,6,0,0" TextWrapping="Wrap"
                               FontSize="16" Foreground="#172B27" />
                    <StackPanel x:Name="ExamplePanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock Text="例句" FontSize="11" FontWeight="SemiBold" Foreground="#52625D" />
                        <TextBlock x:Name="ExampleSource" Margin="0,7,0,0" TextWrapping="Wrap"
                                   FontSize="13" Foreground="#172B27" />
                        <TextBlock x:Name="ExampleTranslation" Margin="0,5,0,0" TextWrapping="Wrap"
                                   FontSize="13" Foreground="#52625D" />
                    </StackPanel>
                    <TextBlock x:Name="VoiceStatus" Margin="0,12,0,0" FontSize="11"
                               Foreground="#A34C25" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
