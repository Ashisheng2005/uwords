<Window x:Class="Uword.App.Overlay.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="430" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="White">
    <Border BorderBrush="#AFC2B9" BorderThickness="1" Background="White">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SpeakButton" Width="30" Height="28" ToolTip="播放发音"
                            Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="16" />
                    </Button>
                    <Button x:Name="CloseButton" Width="30" Height="28" ToolTip="关闭"
                            Background="Transparent" BorderThickness="0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="13" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="UWORD" FontSize="11" FontWeight="SemiBold" Foreground="#147D61" />
                    <TextBlock x:Name="SourceName" Margin="0,4,0,0" Foreground="#52625D" FontSize="12" />
                </StackPanel>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock x:Name="VoiceStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="#A34C25" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TranslationButton" Content="翻译" Width="62" Height="28" />
                    <Button x:Name="DictionaryButton" Content="释义" Width="62" Height="28" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="ResultContainer" />
                    <Border BorderBrush="#D5DFDB" BorderThickness="0,1,0,0" Margin="0,16,0,10" />
                    <TextBlock x:Name="SelectedText" TextWrapping="Wrap" FontSize="12"
                               Foreground="#52625D" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
