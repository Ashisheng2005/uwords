<Window x:Class="Uword.App.Translation.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uword | 翻译设置" Width="660" Height="760" MinWidth="540" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F6F8F7" ShowInTaskbar="True">
    <DockPanel Background="#F6F8F7">
        <Border DockPanel.Dock="Bottom" BorderBrush="#D5DFDB" BorderThickness="0,1,0,0" Background="White" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TestButton" Content="测试连接" Padding="14,7" Margin="0,0,10,0" />
                    <Button x:Name="SaveButton" Content="保存设置" Padding="14,7" Background="#147D61" Foreground="White" />
                </StackPanel>
                <TextBlock x:Name="Feedback" VerticalAlignment="Center" Foreground="#52625D"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" TextElement.Foreground="#172B27">
                <TextBlock Text="翻译设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="接口地址（Base URL）" />
                <TextBox x:Name="BaseUrlBox" Margin="0,5,0,12" Padding="7" />
                <TextBlock Text="API Key（仅当前 Windows 用户可解密）" />
                <PasswordBox x:Name="ApiKeyBox" Margin="0,5,0,12" Padding="7" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="模型名称" /><TextBox x:Name="ModelBox" Margin="0,5,0,0" Padding="7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="目标语言" /><TextBox x:Name="LanguageBox" Margin="0,5,0,0" Padding="7" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="温度" /><TextBox x:Name="TemperatureBox" Margin="0,5,0,0" Padding="7" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="每秒最大请求" /><TextBox x:Name="RateBox" Margin="0,5,0,0" Padding="7" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="每次最大字数" /><TextBox x:Name="LengthBox" Margin="0,5,0,0" Padding="7" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="每次最大段数" /><TextBox x:Name="ParagraphBox" Margin="0,5,0,0" Padding="7" /></StackPanel>
                </Grid>
                <TextBlock Text="系统提示词" /><TextBox x:Name="SystemBox" Margin="0,5,0,14" Padding="8" Height="138"
                                                AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="多段提示词" /><TextBox x:Name="MultiBox" Margin="0,5,0,14" Padding="8" Height="85"
                                                AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="单段提示词" /><TextBox x:Name="SingleBox" Margin="0,5,0,6" Padding="8" Height="85"
                                                AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="单词释义提示词" Margin="0,12,0,0" />
                <TextBox x:Name="DictionaryBox" Margin="0,5,0,6" Padding="8" Height="132"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="可用变量：{{to}}、{{text}}。多段译文须用独立一行的 %% 分隔；单词释义须返回 JSON。"
                           Foreground="#52625D" FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
