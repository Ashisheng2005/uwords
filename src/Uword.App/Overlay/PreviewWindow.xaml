<Window x:Class="Uword.App.Overlay.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="410" Height="310" MinHeight="200" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="#FFFFFF">
    <Border BorderBrush="#AFC2B9" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="X" Width="26" Height="26"
                        ToolTip="Close preview" Background="Transparent" BorderThickness="0"
                        FontSize="20" Foreground="#52625D" />
                <StackPanel>
                <TextBlock Text="UWORD · 翻译" FontSize="11" FontWeight="SemiBold" Foreground="#147D61" />
                    <TextBlock x:Name="SourceName" Margin="0,4,0,0" Foreground="#52625D" FontSize="12" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TranslatedText" TextWrapping="Wrap" FontSize="15"
                               Foreground="#172B27" />
                    <Border BorderBrush="#D5DFDB" BorderThickness="0,1,0,0" Margin="0,14,0,10" />
                    <TextBlock x:Name="SelectedText" TextWrapping="Wrap" FontSize="12"
                               Foreground="#52625D" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
